# Plain NequIP baseline (no e2IP head) on the same 10% MatPES-PBE subset. Same 5 h LR/energy-weight
# schedule as the e2IP run, stopped at 120 min like the evaluated e2IP checkpoint; all four components.
MODEL_TYPE=nequip
TRAIN_HOURS=5
STOP_AFTER_MIN=120
EVAL_STAGES="force-matpes phase neb omat24"
NEB_FRACTION=0.1
OMAT_FRACTION=0.1
