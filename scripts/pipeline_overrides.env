# eIP-NequIP (eIP evidential head, arXiv:2407.13994) on the same 10% MatPES-PBE subset. Same 5 h
# LR/energy-weight schedule as the e2IP and plain NequIP runs, stopped at 120 min; all four components.
MODEL_TYPE=eip
TRAIN_HOURS=5
STOP_AFTER_MIN=120
EVAL_STAGES="force-matpes phase neb omat24"
NEB_FRACTION=0.1
OMAT_FRACTION=0.1
